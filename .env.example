# ==============================================================================
# PAISAWISE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Configuration (Client-side / Anon Key only)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth & Google Sheets API Integration
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Enable 'Google Sheets API' & 'Google Drive API' in Library
# Authorize JavaScript Origins: http://localhost:5173 and your Vercel deployment URL
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-optional-google-api-key

# Application URL
VITE_APP_URL=http://localhost:5173

# SECURITY NOTICE:
# DO NOT include Supabase Service Role Key or Google Client Secret in this file or any VITE_* variable!
