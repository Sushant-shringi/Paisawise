# ==============================================================================
# PAISAWISE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT BACKEND & DATABASE (Zero External Setup Required)
# ------------------------------------------------------------------------------
# The backend server defaults to port 4000 and uses a local SQLite database at ./data/paisawise.db.
PORT=4000
DATABASE_PATH=./data/paisawise.db
JWT_SECRET=paisawise-super-secret-local-jwt-key-32chars!
NODE_ENV=development

# Application Frontend URL
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & CLOUD (Optional for Local Development)
# ------------------------------------------------------------------------------
# In local development, the backend defaults to SQLite (DATABASE_PATH).
# When connecting to Supabase PostgreSQL, provide your connection URI:
# (Recommended: Supabase Session Pooler URI on Port 5432 or Direct URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Frontend Supabase Client (Optional if using direct Express backend API):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH & GOOGLE SHEETS API (Optional for Local Development)
# ------------------------------------------------------------------------------
# Create OAuth credentials in Google Cloud Console -> APIs & Services -> Credentials
# Authorize JavaScript Origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-optional-google-api-key

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP DISPATCH (Optional: To receive real emails in your inbox)
# ------------------------------------------------------------------------------
# When blank, PaisaWise displays and autofills the OTP directly on-screen.
# To deliver actual verification emails to your real inbox:
# For Gmail: Use your Gmail address + a 16-char App Password (from https://myaccount.google.com/apppasswords)
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="PaisaWise Security" <your-email@gmail.com>
# Or custom SMTP:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587

# SECURITY NOTICE:
# NEVER commit production secrets, service role keys, or production database passwords to version control!
